{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://examcard.local/schemas/daily-plan-v1.schema.json",
  "title": "ExamCard Daily Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "date", "timezone", "exam_type", "status", "title", "goal", "mem_suspended", "schedule", "tasks"],
  "properties": {
    "schema_version": { "const": "examcard.daily-plan/v1" },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "const": "Asia/Shanghai" },
    "exam_type": { "type": "string", "minLength": 1, "maxLength": 40 },
    "status": { "enum": ["planned", "active", "paused", "completed", "cancelled"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "goal": { "type": "string", "maxLength": 2000 },
    "mem_suspended": { "type": "boolean" },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "end": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "kind": { "enum": ["task", "break", "rest"] },
          "label": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "course": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "topic": { "type": ["string", "null"], "maxLength": 300 },
        "provider": { "type": ["string", "null"], "maxLength": 300 },
        "video_title": { "type": ["string", "null"], "maxLength": 300 },
        "url": { "type": ["string", "null"], "maxLength": 2000 },
        "verified": { "type": "boolean" }
      }
    },
    "material": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 300 },
        "chapter": { "type": ["string", "null"], "maxLength": 300 },
        "pages": { "type": ["string", "null"], "maxLength": 100 },
        "textbook_id": { "type": ["string", "null"] },
        "chapter_id": { "type": ["string", "null"] }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "minutes"],
      "properties": {
        "type": { "enum": ["video", "examples", "practice", "review", "mock", "reading", "other"] },
        "minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "question_set_id": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "acceptance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "target_correct": { "type": ["integer", "null"], "minimum": 0 },
        "target_total": { "type": ["integer", "null"], "minimum": 0 },
        "require_error_review": { "type": "boolean" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "subject", "topic", "priority", "start", "end", "planned_minutes", "learning_mode", "course", "material", "stages", "acceptance"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 200 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "priority": { "enum": ["high", "normal", "low"] },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "planned_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "learning_mode": { "enum": ["course_first", "mock", "practice", "review", "textbook", "other"] },
        "course": { "$ref": "#/$defs/course" },
        "material": { "$ref": "#/$defs/material" },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/stage" } },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      }
    }
  }
}
